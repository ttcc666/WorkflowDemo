{
  "startNodeId": "start",
  "notifications": [
    { "events": ["Enter"], "recipients": [{ "type": "Assignees", "value": "" }], "channels": ["InApp"],
      "title": "待审批：{标题}", "content": "【待审批】{标题}，申请人 {申请人}，当前环节：{节点}" },
    { "events": ["Rejected"], "recipients": [{ "type": "Initiator", "value": "" }], "channels": ["InApp"],
      "content": "【驳回】{标题}，{操作人} 在 {节点} 驳回：{意见}" },
    { "events": ["Completed"], "recipients": [{ "type": "Initiator", "value": "" }, { "type": "Approvers", "value": "" }],
      "channels": ["InApp"], "title": "审批{结果}：{标题}", "content": "【{结果}】{标题}" }
  ],
  "nodes": {
    "start":   { "name": "提交注销", "type": "Start", "next": "fork" },
    "fork":    { "name": "并行会审", "type": "Parallel", "branches": [
                   { "priority": 1, "next": "quality" },
                   { "priority": 2, "next": "safety" } ] },
    "quality": { "name": "质量审核", "type": "Approval", "mode": "Any",
                 "approvers": [{ "type": "Role", "value": "QualityManager" }], "next": "join" },
    "safety":  { "name": "安全审核", "type": "Approval", "mode": "Any",
                 "approvers": [{ "type": "Role", "value": "SafetyOfficer" }], "next": "join" },
    "join":    { "name": "会审完成", "type": "Join", "next": "leader" },
    "leader":  { "name": "负责人会签", "type": "Approval", "mode": "All",
                 "approvers": [{ "type": "Role", "value": "Leader" }], "next": "end",
                 "timeout": { "minutes": 2880, "action": "Remind", "repeatMinutes": 720, "maxReminders": 2 },
                 "notifications": [
                   { "events": ["Approved"], "recipients": [{ "type": "Initiator", "value": "" }], "channels": ["InApp"],
                     "content": "【会签进度】{标题}，{操作人} 已同意，待会签：{当前审批人}" }
                 ] },
    "end":     { "name": "结束", "type": "End" }
  }
}
