{
  "name": "@approval/shared",
  "version": "0.4.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./*": "./src/*.ts"
  },
  "files": ["dist"],
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./contracts": { "types": "./dist/contracts/index.d.ts", "import": "./dist/contracts/index.js" },
      "./*": { "types": "./dist/*.d.ts", "import": "./dist/*.js" }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": { "build": "tsc -p tsconfig.build.json", "typecheck": "tsc --noEmit", "test": "vitest run" },
  "dependencies": { "@dagrejs/dagre": "^3.1.3" },
  "devDependencies": { "@types/node": "^26.6.6", "typescript": "^5.9.3", "vite": "^8.3.5", "vitest": "^5.0.5" }
}
