{
  "name": "approval-web",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter approval-demo dev",
    "build": "pnpm --filter approval-demo build",
    "build:lib": "pnpm --filter @approval/ui build",
    "check:boundaries": "node ../eng/check-boundaries.mjs",
    "test:boundaries": "node --test ../eng/check-boundaries.test.mjs ../eng/resolve-declaration-imports.test.mjs",
    "contracts:check": "node scripts/contracts.mjs",
    "contracts:update": "node scripts/contracts.mjs --update",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0"
  }
}
