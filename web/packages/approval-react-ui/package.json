{
  "name": "@approval/react-ui",
  "version": "0.3.0",
  "type": "module",
  "description": "共享审批协议的 React 19 组件库、流程与表单设计器",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./style.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "FEATURE_PARITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./contracts": {
        "types": "./dist/types/contracts.d.ts"
      },
      "./style.css": "./dist/approval-react-ui.css"
    },
    "types": "./dist/types/index.d.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@approval/shared": "workspace:*",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "codemirror": "6.0.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.6.2",
    "radix-ui": "1.8.1",
    "react-day-picker": "^10.0.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "^27.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
