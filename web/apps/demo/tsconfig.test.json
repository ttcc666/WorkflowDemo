{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "noEmit": true,
    "types": [
      "element-plus/global",
      "node"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ui/*": ["../../packages/approval-ui/src/*"],
      "@demo-shared/*": [
        "../../demo-shared/*"
      ]
    }
  },
  "include": [
