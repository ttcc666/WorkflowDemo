    { "expr": "ifnull(a, 0) + 1", "vars": { "a": 2 }, "result": 3 },
    { "expr": "total - ifnull(advance, 0)", "vars": { "total": 300 }, "result": 300 },
    { "expr": "if(a > 0, a, -a) + abs(b)", "vars": { "a": -2, "b": -3 }, "result": 5 },
