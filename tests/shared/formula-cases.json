    { "expr": "if(a >= 100, 1, 0)", "vars": { "a": 100 }, "result": 1 },
    { "expr": "if(a <= 99, 1, 0)", "vars": { "a": 100 }, "result": 0 },
    { "expr": "if(a < b, 1, 0)", "vars": { "a": 1, "b": 2 }, "result": 1 },
    { "expr": "if(a == b, 1, 0)", "vars": { "a": 2, "b": 2 }, "result": 1 },
    { "expr": "if(a != b, 1, 0)", "vars": { "a": 2, "b": 2 }, "result": 0 },
    { "expr": "if(0.1 + 0.2 == 0.3, 1, 0)", "result": 1 },
    { "expr": "if(a > 1, 1, 0)", "vars": { "a": null }, "result": null },
    { "expr": "if((a > 1), 1, 0)", "vars": { "a": 3 }, "result": 1 },
    { "expr": "IF(a > 1, Round(a / 3, 1), 0)", "vars": { "a": 10 }, "result": 3.3 },
