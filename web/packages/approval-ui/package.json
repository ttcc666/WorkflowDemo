{
  "name": "@approval/ui",
  "version": "0.4.1",
  "description": "Approval.Core 的 Vue 3 + Element Plus 前端：审批工作台、审批详情、流程设计器、表单设计器、发起中心",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./contracts": {
      "types": "./src/contracts/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": "./dist/approval-ui.css",
      "./contracts": {
        "types": "./dist/types/contracts/index.d.ts"
      }
    },
    "types": "./dist/types/index.d.ts"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.lib.json && node scripts/resolve-declaration-imports.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@dagrejs/dagre": "^3.1.3",
    "codemirror": "6.0.2",
    "@approval/shared": "workspace:*"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "element-plus": "^2.14.7",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue/tsconfig": "^0.9.1",
    "element-plus": "^2.14.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  }
}
