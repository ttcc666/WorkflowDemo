<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Approval.Certificate</PackageId>
    <Version>$(ApprovalVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>可复用的注册证审批模块：业务校验、单据快照、审批回调、HTTP 接口、EF Core 迁移与默认流程。</Description>
    <PackageTags>approval;workflow;certificate;efcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Approval.AspNetCore/Approval.AspNetCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <EmbeddedResource Include="Flows/*.json" />
    <Content Include="Flows/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles/any/any/Flows" PackageCopyToOutput="true" />
  </ItemGroup>
</Project>
