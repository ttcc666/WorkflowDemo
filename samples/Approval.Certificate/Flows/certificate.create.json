          "type": "DeptLeader",
          "value": "1"
        }
      ],
      "next": "quality",
      "allowReturn": false,
      "allowAddSign": false,
      "allowTransfer": false,
      "requireQualifiedAssignee": true,
      "emptyApproverPolicy": "Error",
      "timeout": {
        "minutes": 1440,
        "action": "Remind",
        "repeatMinutes": 240,
        "maxReminders": 3
      }
    },
    "quality": {
      "name": "质量/法规复审",
      "type": "Approval",
      "mode": "Any",
      "approvers": [
        {
          "type": "Role",
          "value": "QualityManager"
        }
      ],
      "next": "leader",
      "allowReturn": false,
      "allowAddSign": false,
      "allowTransfer": false,
      "requireQualifiedAssignee": true,
      "emptyApproverPolicy": "Error",
      "timeout": {
        "minutes": 1440,
        "action": "Remind",
        "repeatMinutes": 240,
        "maxReminders": 3
      }
    },
    "leader": {
      "name": "负责人终审",
      "type": "Approval",
      "mode": "Any",
      "approvers": [
        {
          "type": "Role",
          "value": "Leader"
        }
      ],
      "next": "end",
      "allowReturn": false,
      "allowAddSign": false,
      "allowTransfer": false,
      "requireQualifiedAssignee": true,
      "emptyApproverPolicy": "Error",
      "timeout": {
        "minutes": 1440,
        "action": "Remind",
        "repeatMinutes": 240,
        "maxReminders": 3
      }
    },
    "end": {
      "name": "正式台账生效",
      "type": "End"
    }
  }
