{"schemaVersion":1,
  "name": "注册证登记（三级审核）",
  "startNodeId": "start",
  "notifications": [
    {
      "events": [
        "Enter"
      ],
      "recipients": [
        {
          "type": "Assignees",
          "value": ""
        }
      ],
      "channels": [
        "InApp"
      ],
      "title": "注册证待审核：{标题}",
      "content": "申请人 {申请人}，注册证 {form.certNo}，当前环节：{节点}。"
    },
    {
      "events": [
        "Completed"
      ],
      "recipients": [
        {
          "type": "Initiator",
          "value": ""
        }
      ],
      "channels": [
        "InApp"
      ],
      "title": "注册证审核{结果}：{标题}",
