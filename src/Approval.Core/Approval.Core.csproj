<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Approval.Core</PackageId>
    <Version>0.1.0</Version>
    <Description>通用审批流程引擎：多版本流程定义、或签 / 会签 / 依次审批、条件与并行分支、退回 / 转交 / 加签、表单审批、通知与 Outbox 可靠投递、超时处理。基于 EF Core，与宿主业务同一事务。</Description>
    <PackageTags>approval;workflow;efcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.6" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Approval.Core.Tests" />
  </ItemGroup>

</Project>
