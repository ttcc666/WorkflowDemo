<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Approval.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Description>Approval.Core 的 ASP.NET Core 集成：通用审批接口（Minimal API）、当前用户与用户目录抽象、异常映射为 ProblemDetails。</Description>
    <PackageTags>approval;workflow;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Approval.Core\Approval.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Approval.AspNetCore.Tests" />
  </ItemGroup>

</Project>
