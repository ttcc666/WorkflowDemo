    { "expr": "2 / 3 * 3", "precision": 2, "result": 2 },
    { "expr": "1 / 8", "precision": 2, "result": 0.13 },
    { "expr": "a / 0", "vars": { "a": 1 }, "result": null },
    { "expr": "a + b", "vars": { "a": 1, "b": null }, "result": null },
    { "expr": "a * 2", "vars": {}, "result": null },
    { "expr": "round(2.345, 2)", "result": 2.35 },
    { "expr": "round(-2.345, 2)", "result": -2.35 },
    { "expr": "round(1.005, 2)", "result": 1.01 },
    { "expr": "round(2.5, 0)", "result": 3 },
    { "expr": "round(-2.5, 0)", "result": -3 },
    { "expr": "round(a, 1)", "vars": { "a": null }, "result": null },
    { "expr": "min(3, 1, 2)", "result": 1 },
    { "expr": "max(3, 1, 2)", "result": 3 },
    { "expr": "max(a)", "vars": { "a": 5 }, "result": 5 },
    { "expr": "min(a, 1)", "vars": { "a": null }, "result": null },
    { "expr": "abs(-4.5)", "result": 4.5 },
